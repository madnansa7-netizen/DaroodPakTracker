<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF7EE"
    android:fitsSystemWindows="true">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="#00493A">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☾  Darood Pak Tracker"
            android:textColor="#FFFDF7"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ﷲ"
            android:textColor="#E6C35A"
            android:textSize="30sp"
            android:gravity="center" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">

            <!-- Durood-e-Pak Calligraphy Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:background="#FFFDF7">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  دُرُودِ پاک  ✦"
                    android:textColor="#BE912D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/duroodCalligraphy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="صَلّی اللّٰہُ عَلٰی حَبِیبِہ سٙیّدنٙا مُحَمَّدٍ وَّآلِہ وَسَلَّمَ"
                    android:textColor="#00493A"
                    android:textSize="25sp"
                    android:fontFamily="serif"
                    android:textStyle="normal"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <View
                    android:layout_width="90dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="14dp"
                    android:background="#BE912D" />

            </LinearLayout>

            <!-- Date -->
            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="18dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:textColor="#00493A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Question -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aaj kitni dafa Durood e Pak parha?"
                android:textColor="#00493A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Count Input -->
            <EditText
                android:id="@+id/countInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:hint="Durood ki quantity"
                android:inputType="number"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="20sp" />

            <!-- Save / Update -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_bg"
                android:text="SAVE / UPDATE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Today's Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S TOTAL"
                    android:textColor="#BE912D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/todayTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#00493A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Month-wise Records -->
            <Button
                android:id="@+id/monthsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_bg"
                android:text="📅  MONTH-WISE RECORDS"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Overall Total -->
            <Button
                android:id="@+id/overallButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_bg"
                android:text="✦  OVERALL TOTAL"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Bottom Dua -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Aap ka record sirf isi phone par save hota hai.&#10;Allah Ta'ala aap ka Durood qabool farmaye.&#10;Aameen."
                android:textColor="#4D5A54"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
