<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF7EE">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:background="#00493A">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☾  Darood Pak Tracker"
            android:textColor="#FFFDF7"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ﷲ"
            android:textColor="#E6C35A"
            android:textSize="30sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">

            <!-- DUROOD CALLIGRAPHY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="#FFFDF7">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  دُرُودِ پاک  ✦"
                    android:textColor="#BE912D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- ACTUAL CALLIGRAPHY IMAGE -->
                <ImageView
                    android:id="@+id/duroodCalligraphy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxHeight="105dp"
                    android:src="@drawable/darood_pak_calligraphy"
                    android:scaleType="fitCenter"
                    android:contentDescription="Durood e Pak Calligraphy"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <View
                    android:layout_width="90dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="#BE912D" />

            </LinearLayout>

            <!-- DATE -->
            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="18dp"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:textColor="#00493A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- QUESTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aaj kitni dafa Durood e Pak parha?"
                android:textColor="#00493A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- COUNT INPUT -->
            <EditText
                android:id="@+id/countInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:hint="Durood ki quantity"
                android:inputType="number"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="20sp" />

            <!-- SAVE / UPDATE -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_bg"
                android:text="SAVE / UPDATE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- TODAY'S TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S TOTAL"
                    android:textColor="#BE912D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/todayTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#00493A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ALL-TIME TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL-TIME TOTAL"
                    android:textColor="#BE912D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overallTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#00493A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MONTH-WISE RECORDS -->
            <Button
                android:id="@+id/monthsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_bg"
                android:text="📅  MONTH-WISE RECORDS"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- OVERALL TOTAL -->
            <Button
                android:id="@+id/overallButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_bg"
                android:text="✦  OVERALL TOTAL"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- BOTTOM MESSAGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Aap ka record sirf isi phone par save hota hai.&#10;Allah Ta'ala aap ka Durood qabool farmaye.&#10;Aameen."
                android:textColor="#4D5A54"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
